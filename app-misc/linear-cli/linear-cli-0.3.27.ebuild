inherit cargo desktop

DESCRIPTION="Command-line client for Linear.app issue and project workflows"
HOMEPAGE="https://github.com/nesszer/linear-cli"
SRC_URI="
	https://github.com/nesszer/${PN}/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

RDEPEND="
	app-shells/fish
	gui-apps/foot
"

src_install() {
	cargo_src_install

	cat > "${T}"/linear-cli-launcher <<-EOF
		#!/usr/bin/env fish
		set -gx LINEAR_CLI_NO_PAGER true
		exec linear-cli interactive
	EOF
	dobin "${T}"/linear-cli-launcher

	cat > "${T}"/linear-cli.desktop <<-EOF
		[Desktop Entry]
		Type=Application
		Name=Linear
		Comment=Linear.app command-line client
		Exec=foot --app-id=linear-cli --title=Linear -e linear-cli-launcher
		Terminal=false
		Categories=Development;ProjectManagement;
		Keywords=linear;issues;projects;tickets;
	EOF
	domenu "${T}"/linear-cli.desktop

	einstalldocs
}
