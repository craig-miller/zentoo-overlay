From: Zentoo <zentoo@localhost>
Subject: [PATCH] Use Ctrl+I to toggle shortcut inhibition

Use an application-level Ctrl+I chord as the local shortcut-inhibitor
toggle. This avoids compositor-level Mod bindings, allowing the same
shortcut to toggle inhibition both off and back on.

--- a/src/main.c
+++ b/src/main.c
@@ -791,7 +791,10 @@ void on_keyboard_event(struct keyboard_collection* collection,
 	// TODO handle multiple symbols
 	xkb_keysym_t symbol = xkb_state_key_get_one_sym(keyboard->state, key);
 
-	if (symbol == XKB_KEY_F12) {
+	bool ctrl_active = xkb_state_mod_name_is_active(keyboard->state,
+			XKB_MOD_NAME_CTRL, XKB_STATE_MODS_EFFECTIVE);
+
+	if (ctrl_active && (symbol == XKB_KEY_i || symbol == XKB_KEY_I)) {
 		if (!is_pressed) {
 			inhibitor_toggle(inhibitor, keyboard->seat);
 		}
@@ -1068,7 +1071,7 @@ Usage: wlvncc <address> [port]\n\
     -h,--help                Get help.\n\
     -n,--hide-cursor         Hide the client-side cursor.\n\
     -d,--no-decorations      Do not request window decorations from the compositor\n\
-    -i,--shortcut-inhibit    Enable the shortcut inhibitor while being focused.\n\
+    -i,--shortcut-inhibit    Enable the shortcut inhibitor while focused; Ctrl+I toggles it.\n\
     -q,--quality             Quality level (0 - 9).\n\
     -t,--tls-cert            Use given TLS cert for authenticating server.\n\
     -s,--use-sw-renderer     Use software rendering.\n\
