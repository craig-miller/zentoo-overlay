+fn render_level_lines(frame: &mut Frame, area: Rect, data: &[u64], fg: Color, bg: Color, mirror_down: bool) {
+    if area.width == 0 || area.height == 0 {
+        return;
+    }
+
+    let buf = frame.buffer_mut();
+    for y in area.y..area.y + area.height {
+        for x in area.x..area.x + area.width {
+            buf.set_string(x, y, " ", Style::default().bg(bg));
+        }
+    }
+
+    let height = area.height as u64;
+    for (idx, value) in data.iter().enumerate() {
+        if idx >= area.width as usize {
+            break;
+        }
+        let level = (*value).min(100);
+        if level == 0 {
+            continue;
+        }
+        let active_rows = ((level * height) + 99) / 100;
+        let x = area.x + idx as u16;
+        if mirror_down {
+            for offset in 0..active_rows as u16 {
+                buf.set_string(x, area.y + offset, "│", Style::default().fg(fg).bg(bg));
+            }
+        } else {
+            for offset in 0..active_rows as u16 {
+                buf.set_string(
+                    x,
+                    area.y + area.height - 1 - offset,
+                    "│",
+                    Style::default().fg(fg).bg(bg),
+                );
+            }
+        }
+    }
+}
