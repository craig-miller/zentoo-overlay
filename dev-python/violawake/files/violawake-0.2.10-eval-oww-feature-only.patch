@@ -19,6 +19,25 @@
 
 logger = logging.getLogger(__name__)
 
+
+def _create_oww_backbone_model(OWWModel):
+    """Create an OpenWakeWord model for feature extraction only.
+
+    Evaluation only needs OpenWakeWord's shared preprocessor/backbone to extract
+    embeddings for the trained ViolaWake model. Gentoo's package ships the ONNX
+    feature models, but not optional bundled pretrained wake classifiers such as
+    alexa_v0.1.onnx, so prevent openWakeWord from auto-loading them.
+    """
+
+    import openwakeword
+
+    saved_models = openwakeword.MODELS
+    try:
+        openwakeword.MODELS = {}
+        return OWWModel(wakeword_models=[], inference_framework="onnx")
+    finally:
+        openwakeword.MODELS = saved_models
+
 _OWW_EMBEDDING_DIM = 96
 _DEFAULT_TEMPORAL_SEQ_LEN = 9
 
