+def _create_oww_backbone_model(OWWModel):
+    """Create an OpenWakeWord model for feature extraction only.
+
+    ViolaWake training uses OpenWakeWord's shared audio preprocessor/backbone to
+    extract embeddings; it does not need OpenWakeWord's bundled pretrained wake
+    classifiers. Gentoo's source package ships the ONNX feature models but not
+    the optional pretrained classifier blobs, so prevent openWakeWord from
+    auto-loading every default wake model.
+    """
+
+    import openwakeword
+
+    saved_models = openwakeword.MODELS
+    try:
+        openwakeword.MODELS = {}
+        return OWWModel(wakeword_models=[], inference_framework="onnx")
+    finally:
+        openwakeword.MODELS = saved_models
+
+
