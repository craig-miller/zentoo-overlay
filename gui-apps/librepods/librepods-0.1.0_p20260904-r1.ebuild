inherit cargo desktop xdg

LIBREPODS_COMMIT="672e65ad36eebf21ff1c1a508066f9197ee56d17"

DESCRIPTION="Control AirPods features on Linux"
HOMEPAGE="https://github.com/librepods-org/librepods"
SRC_URI="
	https://github.com/librepods-org/${PN}/archive/${LIBREPODS_COMMIT}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}-${LIBREPODS_COMMIT}/linux-rust"

LICENSE="AGPL-3"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

RDEPEND="
	media-libs/libpulse
	net-wireless/bluez
	sys-apps/dbus
"
DEPEND="${RDEPEND}"

PATCHES=(
	"${FILESDIR}/${P}-tray-optional.patch"
)

src_install() {
	dobin target/release/librepods

	domenu assets/me.kavishdevar.librepods.desktop

	cat > "${T}"/${PN}-autostart.desktop <<-EOF
		[Desktop Entry]
		Type=Application
		Name=LibrePods
		Exec=librepods --start-minimized
		Icon=me.kavishdevar.librepods
		Terminal=false
		NoDisplay=true
		Categories=Utility;
	EOF
	insinto /etc/xdg/autostart
	newins "${T}"/${PN}-autostart.desktop ${PN}.desktop

	newicon -s 256 assets/icon.png me.kavishdevar.librepods.png

	dodoc "${WORKDIR}/${PN}-${LIBREPODS_COMMIT}"/README.md
}

pkg_postinst() {
	xdg_pkg_postinst

	elog "LibrePods can control AirPods listening modes and report battery status."
	elog "A global XDG autostart entry launches it at login with --start-minimized."
	elog "If your session has no StatusNotifier watcher, the app retries briefly"
	elog "and then continues without a tray icon."
}
