+
+    public func detectSystemToolchains(_ ctx: SwiftlyCoreContext) async -> [ToolchainVersion: FilePath] {
+        guard let (version, location) = await self.systemSwift(ctx) else {
+            return [:]
+        }
+        return [version: location]
+    }
+
+    /// Locate a distro-provided Swift toolchain that swiftly does not manage and
+    /// return its version and install location. Generic across Linux distros: it
+    /// finds `swift` on PATH (skipping swiftly's own proxy bin dir), fully
+    /// resolves it, asks it for its version, and derives the toolchain root.
+    private func systemSwift(_ ctx: SwiftlyCoreContext) async -> (ToolchainVersion, FilePath)? {
+        let swiftlyBin = self.swiftlyBinDir(ctx)
+        let swiftlyHome = self.swiftlyHomeDir(ctx).string
+
+        var candidates: [FilePath] = []
+        if let pathVar = ProcessInfo.processInfo.environment["PATH"] {
+            for dir in pathVar.split(separator: ":", omittingEmptySubsequences: true) {
+                let d = FilePath(String(dir))
+                if d == swiftlyBin { continue }
+                candidates.append(d / "swift")
+            }
+        }
+        candidates.append(FilePath("/usr/bin/swift"))
+
+        for candidate in candidates {
+            guard (try? await fs.exists(atPath: candidate)) == true else { continue }
+            // Fully resolve symlinks (eselect on Gentoo, alternatives, etc.).
+            let resolvedOut = (try? await self.runProgramOutput("/usr/bin/readlink", "-f", candidate.string)) ?? nil
+            guard let resolvedOut else { continue }
+            let resolved = resolvedOut.trimmingCharacters(in: .whitespacesAndNewlines)
+            // Never treat a swiftly-managed toolchain or its own proxy as "system".
+            guard !resolved.isEmpty, !resolved.hasPrefix(swiftlyHome) else { continue }
+            // Ask the toolchain for its version.
+            let versionOut = (try? await self.runProgramOutput(candidate.string, "--version")) ?? nil
+            guard let versionOut, let version = Self.parseSwiftVersion(versionOut) else { continue }
+            // Linux toolchains live at <root>/usr/bin/<exe>; strip those three
+            // components to get the root swiftly should point at.
+            let location = FilePath(resolved).removingLastComponent().removingLastComponent()
+                .removingLastComponent()
+            return (version, location)
+        }
+        return nil
+    }
+
+    /// Parse "Swift version X.Y[.Z] ..." from `swift --version` output.
+    static func parseSwiftVersion(_ output: String) -> ToolchainVersion? {
+        guard let marker = output.range(of: "Swift version ") else { return nil }
+        let digits = output[marker.upperBound...].prefix { $0.isNumber || $0 == "." }
+        let parts = digits.split(separator: ".").compactMap { Int($0) }
+        guard parts.count >= 2 else { return nil }
+        let patch = parts.count >= 3 ? parts[2] : 0
+        return try? ToolchainVersion(parsing: "\(parts[0]).\(parts[1]).\(patch)")
     }
 
