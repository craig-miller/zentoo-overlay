+    public func findToolchainLocation(_ ctx: SwiftlyCoreContext, _ toolchain: ToolchainVersion) async throws -> FilePath
     {
-        self.swiftlyToolchainsDir(ctx) / "\(toolchain.name)"
+        // A system (distro-managed) toolchain resolves to its real location,
+        // never into swiftly's own toolchains directory.
+        if let location = await self.detectSystemToolchains(ctx)[toolchain] {
